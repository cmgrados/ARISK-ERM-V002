# Development Environment Configuration
ENVIRONMENT=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (SQLite por defecto en desarrollo)
DATABASE_URL=sqlite:///db.sqlite3

# Generada con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-development-key-change-me-in-production-32chars

# Supabase (opcional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Logging
LOG_LEVEL=DEBUG
