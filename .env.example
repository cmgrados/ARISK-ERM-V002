# ============================================================================
# ARISK ERM - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   docker-compose up -d
# ============================================================================

# ============================================================================
# DJANGO SETTINGS
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=production

# Django Secret Key (generate new: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-change-me-in-production

# Debug mode (NEVER True in production)
DEBUG=False

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database name
DB_NAME=arisk_erm

# Database user
DB_USER=arisk

# Database password (CHANGE THIS!)
DB_PASSWORD=arisk_secure_pass_change_me

# Database host (use 'db' when using Docker)
DB_HOST=db

# Database port
DB_PORT=5432

# Database connection timeout
DATABASE_CONN_MAX_AGE=600

# ============================================================================
# CACHE & SESSION CONFIGURATION
# ============================================================================

# Redis URL (use 'redis://redis:6379/0' for Docker)
REDIS_URL=redis://redis:6379/0

# Cache backend
CACHE_BACKEND=django_redis.cache.RedisCache

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# SSL/HTTPS settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Email backend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# SMTP credentials
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Default from email
DEFAULT_FROM_EMAIL=noreply@arisk-erm.com

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry error tracking (optional)
SENTRY_DSN=

# ============================================================================
# AWS S3 CONFIGURATION (Optional - for media files storage)
# ============================================================================

# AWS access key
AWS_ACCESS_KEY_ID=

# AWS secret access key
AWS_SECRET_ACCESS_KEY=

# AWS S3 bucket name
AWS_STORAGE_BUCKET_NAME=

# AWS S3 region
AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Analytics/Tracking (optional)
GOOGLE_ANALYTICS_ID=

# API rate limiting
RATE_LIMIT_ANON=100/hour
RATE_LIMIT_AUTH=1000/hour

# ============================================================================
# DEPLOYMENT SPECIFIC
# ============================================================================

# Docker environment (development, staging, production)
DOCKER_ENV=production

# Number of Gunicorn workers
WORKERS=4

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
