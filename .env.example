# A.RISK ERM - Environment Configuration
# Copy this file to .env and fill in with your values
# DO NOT commit .env to git (it contains secrets)

# ============================================================================
# DJANGO CORE SETTINGS
# ============================================================================

# 🔴 CRITICAL: Replace with a strong random key (at least 32 characters)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-at-least-32-chars

# Environment: development, staging, production
ENVIRONMENT=development

# 🔴 Set to "False" in production
DEBUG=True

# Comma-separated list of allowed hosts
# Development: localhost,127.0.0.1
# Production: myapp.com,www.myapp.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================================================
# DATABASE
# ============================================================================

# SQLite (development default):
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (recommended for production):
# DATABASE_URL=postgres://user:password@localhost:5432/arisk_db
# PostgreSQL on Supabase:
# DATABASE_URL=postgres://user:password@db.PROJECT.supabase.co:5432/postgres

DATABASE_URL=sqlite:///db.sqlite3

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Enable SSL redirect (for production only)
SECURE_SSL_REDIRECT=False

# Enable HSTS headers (for production only, set to 31536000)
SECURE_HSTS_SECONDS=0

# ============================================================================
# EXTERNAL SERVICES - SUPABASE
# ============================================================================

# Supabase Configuration (optional)
# Get from: https://app.supabase.com/project/[your-project]/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# EMAIL CONFIGURATION (for production)
# ============================================================================

# Gmail Example:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# REDIS CACHE (for production)
# ============================================================================

# Local development:
# REDIS_URL=redis://127.0.0.1:6379/1

# Heroku example:
# REDIS_URL=redis://h:password@hostname:port

REDIS_URL=redis://127.0.0.1:6379/1

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
